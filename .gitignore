# Python
__pycache__/
*.pyc
.venv/
.env

# Node
node_modules/

# ── agentkit/ 的产物 ───────────────────────────────────────────────
agentkit/.generated/

# ── hardening/ 的产物 ──────────────────────────────────────────────
hardening/runs/
hardening/.cache/
hardening/.generated/
# 由 runtime/make-task-image.py 从每题 environment/Dockerfile 推导
hardening/runtime/task-images/
hardening/runtime/task-layouts/

# ── envgen / workspace_eval / curate 的产物 ────────────────────────
envgen/.venv/
envgen/.generated/
workspace_eval/.generated/
workspace_eval/output/
workspace_eval/logs/
# experiments/ 是运行产物目录，整个忽略；但模板配置要入库，供他人照抄。
# 注意必须写成 `dir/*` + 反例：写成 `dir/` 时目录本身被忽略，`!` 无法把里面的文件救回来。
workspace_eval/experiments/*
!workspace_eval/experiments/workspace-bench-hard.yaml
curate/.generated/
curate/experiments/
*/runs/
*/output/

# ── 本地语料与发布素材（体积大，不进仓库）─────────────────────────
# 数据集在 HuggingFace 上，用 download_hf_assets.py 取；本地副本不该入 git。
# data/ 下放的是任务拷件、数据集 README/CSV 暂存、以及内部变更日志。
data/
# download_hf_assets.py 的落盘位置（<eval_root>/<dirname>）：tasks_lite / tasks /
# tasks_hard / filesys。按空间大小不入库。
workspace_eval/tasks/
workspace_eval/tasks_*/
workspace_eval/filesys/

# ── curate/:只排除红队样本生成器 ───────────────────────────────────
# 该脚本整体服务于一条内部研究线,不进开源树(本地保留)。
curate/gen_consensus_attack_tasks.py

# ── 内部实验报告:只留本地,不进仓库 ────────────────────────────────
# 含内网 IP:端口、训练平台任务名 / model_id、推理服务实例名等,
# 定位得到内部基础设施。工程方法部分保留在同目录其余 doc 里。
workspace_eval/docs/noise_id_30task_delivery_report.md
workspace_eval/docs/noise_id_downstream_benefit_design.md
workspace_eval/docs/noise_id_experiment_inventory.md
workspace_eval/docs/noise_id_train_to_task_engineering_notes.md
workspace_eval/docs/noise_id_v2t_model_report.md

