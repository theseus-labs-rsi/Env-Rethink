# Copy to .env and fill concrete values.
APP_ID=
APP_KEY=

# Gateway "standard" endpoint for Hy3, GPT-5.6 and DeepSeek V4. The model
# ids below are deployment-specific; fill in the ones your gateway serves.
WS_MODEL_BASE_URL=${WS_MODEL_BASE_URL:-}
GPT56LUNA_MODEL=
WS_LUNA_DISPLAY_NAME=GPT-5.6-Luna
GPT56SOL_MODEL=
WS_DEEPSEEK_MODEL=
WS_DEEPSEEK_DISPLAY_NAME=DeepSeek-V4-Flash

# Optional overrides. APP_ID/APP_KEY are used by default.
JUDGE_BASE_URL=
JUDGE_MODEL=qwen3.8-max

GPT54_BASE_URL=
GPT54_API_KEY=
GEMINI31PRO_BASE_URL=
GEMINI31PRO_API_KEY=
KIMIK25_BASE_URL=
KIMIK25_API_KEY=
GLM51_BASE_URL=
GLM51_API_KEY=
MINIMAXM27_BASE_URL=
MINIMAXM27_API_KEY=
GROK43_BASE_URL=
GROK43_API_KEY=
QWEN36_BASE_URL=
QWEN36_API_KEY=

# DeepSeek V4 models use these through --env-prefix DEEPSEEK.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Optional for ClaudeCode when the provider uses an Anthropic-compatible endpoint.
KIMIK25_ANTHROPIC_BASE_URL=
KIMIK25_ANTHROPIC_MODEL=

# Optional fallback adapter for Chat-Completions-only providers.
CODEX_CHAT_ADAPTER=auto
CODEX_CHAT_ADAPTER_MAX_TOKENS=16384

# ── experiments/workspace-bench-hard.yaml 用的变量 ────────────────────────
# 该模板把所有端点与凭据都放在这里，YAML 里只写 ${变量名}。
# agent 与 judge 各用各的端点与 key。
WS_AGENT_BASE_URL=
WS_AGENT_API_KEY=
WS_JUDGE_BASE_URL=
WS_JUDGE_API_KEY=

# agentkit harness 的 agent 运行时镜像（由 agentkit/build_wb_agent_image.py 产出）。
# 有 WS_AGENT_IMAGE 就直接用它；没有则拿 WS_AGENT_BASE_IMAGE 现叠一层 agent。
WS_AGENT_IMAGE=
WS_AGENT_BASE_IMAGE=
# claude_code | codex；留空则按 api_provider.provider_type 推
# （anthropic → claude_code，其余 → codex）。
WS_AGENT_KIND=

